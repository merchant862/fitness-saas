<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/images/favicon.svg?v=fitaccess-2" type="image/svg+xml" />
    <link rel="shortcut icon" href="/images/favicon.svg?v=fitaccess-2" type="image/svg+xml" />
    <link rel="stylesheet" href="/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/lineicons.css" />
    <title>FitAccess | Premium Fitness Member Area</title>
    <style>
      :root {
        --ink: #101828;
        --muted: #667085;
        --line: #e4e7ec;
        --panel: #f8fafc;
        --blue: #365cf5;
        --green: #16a34a;
        --cyan: #06b6d4;
        --dark: #08111f;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
        overflow-x: hidden;
      }

      body {
        margin: 0;
        background: #ffffff;
        color: var(--ink);
        font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        overflow-x: hidden;
      }

      a {
        text-decoration: none;
      }

      .site {
        min-height: 100vh;
        overflow-x: hidden;
      }

      .nav {
        position: fixed;
        inset: 0 0 auto;
        z-index: 50;
        background: rgba(255, 255, 255, 0.94);
        border-bottom: 1px solid rgba(228, 231, 236, 0.92);
        backdrop-filter: blur(16px);
      }

      .containerx {
        width: min(1160px, calc(100% - 40px));
        margin: 0 auto;
      }

      .nav-inner {
        min-height: 74px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .logo .brand-logo-img {
        width: 152px;
        height: auto;
      }

      .landing-logo img {
        display: block;
        width: 152px;
        height: auto;
      }

      .links {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .links a {
        color: #344054;
        font-size: 14px;
        font-weight: 700;
      }

      .link-box {
        display: inline-flex;
        align-items: center;
      }

      .link-box a:not(.btnx) {
        min-height: 40px;
        display: inline-flex;
        align-items: center;
        padding: 0 13px;
        border: 1px solid transparent;
        border-radius: 8px;
      }

      .link-box a:not(.btnx):hover {
        background: #f2f5ff;
        border-color: #dce3ff;
      }

      .links a:hover {
        color: var(--blue);
      }

      .btnx {
        display: inline-flex;
        min-height: 48px;
        align-items: center;
        justify-content: center;
        gap: 9px;
        padding: 0 20px;
        border: 1px solid transparent;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 800;
        line-height: 1;
        transition: 160ms ease;
      }

      .btn-primaryx {
        color: #ffffff !important;
        background: var(--blue);
        box-shadow: 0 14px 34px rgba(54, 92, 245, 0.28);
      }

      .btn-primaryx:hover {
        background: #2448df;
      }

      .btn-lightx {
        color: var(--ink) !important;
        background: #ffffff;
        border-color: var(--line);
      }

      .btn-outlinex {
        color: var(--ink) !important;
        background: transparent;
        border-color: #cfd6e3;
      }

      .btn-outlinex:hover {
        color: var(--blue) !important;
        border-color: #b9c5ff;
        background: #f3f6ff;
      }

      .hero {
        position: relative;
        min-height: 92vh;
        display: flex;
        align-items: center;
        padding: 112px 0 70px;
        color: #ffffff;
        background:
          linear-gradient(90deg, rgba(8, 17, 31, 0.96) 0%, rgba(8, 17, 31, 0.82) 48%, rgba(8, 17, 31, 0.32) 100%),
          url("https://images.unsplash.com/photo-1517838277536-f5f99be501cd?auto=format&fit=crop&w=2200&q=88") center / cover no-repeat;
      }

      .hero-grid {
        display: grid;
        grid-template-columns: minmax(0, 0.95fr) minmax(340px, 0.68fr);
        gap: 48px;
        align-items: center;
        min-width: 0;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 18px;
        color: #bfdbfe;
        font-size: 13px;
        font-weight: 900;
        text-transform: uppercase;
      }

      .eyebrow::before {
        content: "";
        width: 10px;
        height: 10px;
        border-radius: 999px;
        background: var(--green);
        box-shadow: 0 0 0 7px rgba(22, 163, 74, 0.24);
      }

      .hero h1 {
        max-width: 760px;
        margin: 0 0 22px;
        color: #ffffff;
        font-size: 62px;
        line-height: 1.03;
        font-weight: 900;
        overflow-wrap: break-word;
      }

      .hero p {
        max-width: 660px;
        margin: 0 0 30px;
        color: #e5e7eb;
        font-size: 18px;
        line-height: 1.75;
        overflow-wrap: break-word;
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
      }

      .mockup {
        width: 100%;
        min-width: 0;
        padding: 22px;
        border: 1px solid rgba(255, 255, 255, 0.18);
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.1);
        box-shadow: 0 30px 80px rgba(0, 0, 0, 0.3);
        backdrop-filter: blur(18px);
      }

      .mockup-screen {
        min-width: 0;
        padding: 22px;
        border-radius: 8px;
        background: #ffffff;
      }

      .mockup-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
      }

      .mockup-title strong {
        display: block;
        color: var(--ink);
        font-size: 18px;
      }

      .mockup-title span {
        color: var(--muted);
        font-size: 13px;
      }

      .pill {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: 8px 11px;
        color: #065f46;
        background: #dcfce7;
        font-size: 12px;
        font-weight: 800;
      }

      .metric-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
        margin-bottom: 18px;
      }

      .metric {
        padding: 14px 12px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--panel);
      }

      .metric strong {
        display: block;
        color: var(--ink);
        font-size: 22px;
        line-height: 1;
      }

      .metric span {
        color: var(--muted);
        font-size: 12px;
      }

      .schedule {
        display: grid;
        gap: 10px;
      }

      .schedule-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        padding: 13px;
        border: 1px solid var(--line);
        border-radius: 8px;
      }

      .schedule-row strong {
        color: var(--ink);
        font-size: 14px;
      }

      .schedule-row span {
        color: var(--muted);
        font-size: 12px;
      }

      .preview-card {
        display: grid;
        gap: 16px;
      }

      .preview-hero {
        position: relative;
        overflow: hidden;
        min-height: 190px;
        border-radius: 8px;
        background:
          linear-gradient(180deg, rgba(8, 17, 31, 0.08), rgba(8, 17, 31, 0.72)),
          url("https://images.unsplash.com/photo-1518611012118-696072aa579a?auto=format&fit=crop&w=900&q=86") center / cover no-repeat;
      }

      .preview-hero-content {
        position: absolute;
        right: 18px;
        bottom: 18px;
        left: 18px;
      }

      .preview-hero-content span {
        display: inline-flex;
        margin-bottom: 8px;
        color: #bbf7d0;
        font-size: 12px;
        font-weight: 900;
        text-transform: uppercase;
      }

      .preview-hero-content strong {
        display: block;
        color: #ffffff;
        font-size: 24px;
        line-height: 1.12;
        font-weight: 900;
      }

      .preview-grid {
        display: grid;
        grid-template-columns: 0.9fr 1.1fr;
        gap: 14px;
      }

      .preview-panel {
        min-width: 0;
        padding: 16px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--panel);
      }

      .progress-ring {
        width: 112px;
        height: 112px;
        display: grid;
        place-items: center;
        margin: 0 auto 14px;
        border-radius: 999px;
        background: conic-gradient(var(--green) 0 74%, #e5e7eb 74% 100%);
      }

      .progress-ring-inner {
        width: 78px;
        height: 78px;
        display: grid;
        place-items: center;
        border-radius: 999px;
        background: #ffffff;
        color: var(--ink);
        font-size: 24px;
        font-weight: 900;
      }

      .preview-panel h4 {
        margin: 0 0 4px;
        color: var(--ink);
        font-size: 15px;
        font-weight: 900;
      }

      .preview-panel p {
        margin: 0;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.55;
      }

      .preview-list {
        display: grid;
        gap: 10px;
      }

      .preview-item {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
      }

      .preview-icon {
        width: 34px;
        height: 34px;
        display: inline-flex;
        flex: 0 0 34px;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        color: #ffffff;
        background: var(--blue);
      }

      .preview-item:nth-child(2) .preview-icon {
        background: var(--green);
      }

      .preview-item:nth-child(3) .preview-icon {
        background: var(--cyan);
      }

      .preview-item strong {
        display: block;
        color: var(--ink);
        font-size: 13px;
        line-height: 1.25;
      }

      .preview-item span {
        color: var(--muted);
        font-size: 12px;
      }

      .section {
        padding: 84px 0;
        background: #ffffff;
      }

      .section-soft {
        background: var(--panel);
      }

      .section-dark {
        color: #ffffff;
        background: var(--dark);
      }

      .section-head {
        max-width: 760px;
        margin-bottom: 36px;
      }

      .section-head h2 {
        margin: 0 0 12px;
        color: var(--ink);
        font-size: 40px;
        line-height: 1.14;
        font-weight: 900;
      }

      .section-head p {
        margin: 0;
        color: var(--muted);
        font-size: 16px;
        line-height: 1.75;
      }

      .section-dark .section-head h2,
      .section-dark h2,
      .section-dark h3,
      .section-dark .check strong {
        color: #ffffff;
      }

      .section-dark .section-head p,
      .section-dark p,
      .section-dark .check span {
        color: #cbd5e1;
      }

      .cards {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 22px;
      }

      .cardx {
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: #ffffff;
      }

      .cardx img {
        width: 100%;
        height: 214px;
        display: block;
        object-fit: cover;
      }

      .card-bodyx {
        padding: 24px;
      }

      .iconx {
        width: 44px;
        height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 18px;
        border-radius: 8px;
        color: #ffffff;
        background: var(--blue);
        font-size: 20px;
      }

      .cardx:nth-child(2) .iconx {
        background: var(--green);
      }

      .cardx:nth-child(3) .iconx {
        background: var(--cyan);
      }

      .cardx h3 {
        margin: 0 0 10px;
        color: var(--ink);
        font-size: 21px;
        font-weight: 900;
      }

      .cardx p {
        margin: 0;
        color: var(--muted);
        font-size: 14px;
        line-height: 1.75;
      }

      .split {
        display: grid;
        grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
        gap: 46px;
        align-items: center;
      }

      .photo {
        min-height: 540px;
        border-radius: 8px;
        background:
          linear-gradient(180deg, rgba(8, 17, 31, 0.06), rgba(8, 17, 31, 0.34)),
          url("https://images.unsplash.com/photo-1547592180-85f173990554?auto=format&fit=crop&w=1400&q=88") center / cover no-repeat;
      }

      .checks {
        display: grid;
        gap: 16px;
        margin-top: 26px;
      }

      .check {
        display: grid;
        grid-template-columns: 28px 1fr;
        gap: 12px;
      }

      .check i {
        color: var(--green);
        font-size: 22px;
        margin-top: 2px;
      }

      .check strong {
        display: block;
        margin-bottom: 3px;
        color: var(--ink);
      }

      .check span {
        color: var(--muted);
        font-size: 14px;
        line-height: 1.65;
      }

      .steps {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
      }

      .step {
        padding: 24px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: #ffffff;
      }

      .step span {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 18px;
        border-radius: 999px;
        color: #ffffff;
        background: var(--blue);
        font-weight: 900;
      }

      .step h3 {
        margin: 0 0 8px;
        color: var(--ink);
        font-size: 18px;
      }

      .step p {
        margin: 0;
        color: var(--muted);
        font-size: 14px;
        line-height: 1.7;
      }

      .section-dark .step {
        border-color: rgba(255, 255, 255, 0.16);
        background: rgba(255, 255, 255, 0.07);
      }

      .section-dark .step span {
        color: var(--dark);
        background: #ffffff;
      }

      .link-hub {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
      }

      .link-card {
        min-width: 0;
        display: flex;
        flex-direction: column;
        min-height: 238px;
        padding: 22px;
        border: 1px solid var(--line);
        border-radius: 8px;
        color: var(--ink);
        background: #ffffff;
        transition: 170ms ease;
      }

      .link-card:nth-child(even) {
        color: #ffffff;
        border-color: rgba(255, 255, 255, 0.14);
        background: var(--dark);
      }

      .link-card:hover {
        transform: translateY(-4px);
        border-color: rgba(54, 92, 245, 0.34);
        box-shadow: 0 24px 58px rgba(16, 24, 40, 0.12);
      }

      .link-card-icon {
        width: 46px;
        height: 46px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 18px;
        border-radius: 8px;
        color: #ffffff;
        background: var(--blue);
        font-size: 21px;
      }

      .link-card:nth-child(2) .link-card-icon {
        color: var(--dark);
        background: #ffffff;
      }

      .link-card:nth-child(3) .link-card-icon {
        background: var(--green);
      }

      .link-card:nth-child(4) .link-card-icon {
        color: var(--dark);
        background: #ffffff;
      }

      .link-card strong {
        display: block;
        margin-bottom: 8px;
        color: inherit;
        font-size: 18px;
        line-height: 1.25;
        font-weight: 900;
      }

      .link-card p {
        margin: 0 0 20px;
        color: var(--muted);
        font-size: 14px;
        line-height: 1.65;
      }

      .link-card:nth-child(even) p {
        color: #cbd5e1;
      }

      .link-card span:last-child {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: auto;
        color: var(--blue);
        font-size: 13px;
        font-weight: 900;
      }

      .link-card:nth-child(even) span:last-child {
        color: #ffffff;
      }

      .section-dark .link-card {
        color: #ffffff;
        border-color: rgba(255, 255, 255, 0.14);
        background: rgba(255, 255, 255, 0.07);
      }

      .section-dark .link-card:nth-child(even) {
        background: rgba(255, 255, 255, 0.11);
      }

      .section-dark .link-card p {
        color: #cbd5e1;
      }

      .section-dark .link-card span:last-child {
        color: #ffffff;
      }

      .cta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 28px;
      }

      .cta h2 {
        margin: 0 0 10px;
        color: var(--ink);
        font-size: 38px;
        line-height: 1.16;
        font-weight: 900;
      }

      .cta p {
        max-width: 650px;
        margin: 0;
      }

      .footer {
        padding: 72px 0 0;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        background: var(--dark);
      }

      .footer-inner {
        display: grid;
        grid-template-columns: minmax(280px, 0.9fr) minmax(0, 1.55fr);
        gap: 44px;
        color: #cbd5e1;
        font-size: 14px;
      }

      .footer-brand {
        min-width: 0;
        padding: 28px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.06);
      }

      .footer-brand .footer-logo {
        margin-bottom: 14px;
      }

      .footer-brand .footer-logo img {
        display: block;
        width: 150px;
        height: auto;
      }

      .footer-brand p {
        max-width: 360px;
        margin: 0 0 22px;
        color: #cbd5e1;
        line-height: 1.7;
      }

      .footer-badges {
        display: grid;
        gap: 10px;
      }

      .footer-badge {
        display: flex;
        align-items: center;
        gap: 10px;
        min-height: 42px;
        padding: 0 12px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 8px;
        color: #e5e7eb;
        background: rgba(255, 255, 255, 0.07);
        font-weight: 800;
      }

      .footer-badge i {
        color: var(--blue);
        font-size: 18px;
      }

      .footer-right {
        min-width: 0;
        display: grid;
        gap: 20px;
      }

      .footer-columns {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
      }

      .footer-column {
        min-width: 0;
        padding: 22px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.06);
      }

      .footer-column h3,
      .payment-title {
        margin: 0 0 14px;
        color: #ffffff;
        font-size: 13px;
        font-weight: 900;
        text-transform: uppercase;
      }

      .footer-column a {
        min-height: 38px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin: 0;
        padding: 0;
        border: 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 0;
        color: #cbd5e1;
        background: transparent;
        font-size: 14px;
        font-weight: 500;
        line-height: 1.35;
        overflow-wrap: anywhere;
        transition: 150ms ease;
      }

      .footer-column a:last-child {
        border-bottom: 0;
      }

      .footer-column a:hover {
        color: var(--blue);
        background: transparent;
      }

      .footer-column a i {
        flex: 0 0 auto;
        color: #94a3b8;
        font-size: 13px;
      }

      .footer-column a:hover i {
        color: var(--blue);
      }

      .footer-payments {
        padding: 22px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.06);
      }

      .payment-grid {
        display: grid;
        grid-template-columns: repeat(8, minmax(42px, 1fr));
        gap: 8px;
      }

      .payment-grid img {
        width: 100%;
        height: 30px;
        display: block;
        object-fit: contain;
        padding: 5px 6px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 6px;
        background: #ffffff;
      }

      .footer-bottom {
        margin: 46px 0 0;
        padding: 18px 0;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        background: rgba(0, 0, 0, 0.14);
        color: #cbd5e1;
        font-size: 13px;
      }

      .footer-bottom-inner {
        width: min(1160px, calc(100% - 40px));
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
      }

      .footer-meta {
        display: flex;
        align-items: center;
        gap: 16px;
        min-width: 0;
      }

      .footer-meta span,
      .footer-meta a {
        color: #cbd5e1;
      }

      .footer-tagline {
        color: #94a3b8 !important;
        font-weight: 400;
      }

      .footer-meta a {
        font-weight: 800;
        overflow-wrap: anywhere;
      }

      .footer-meta a:hover {
        color: #ffffff;
      }

      .footer-copy {
        flex: 0 0 auto;
      }

      @media (max-width: 991px) {
        .links .link-box:not(.nav-cta) {
          display: none;
        }

        .hero-grid,
        .cards,
        .split,
        .link-hub,
        .steps {
          grid-template-columns: 1fr;
        }

        .hero h1 {
          font-size: 46px;
        }

        .mockup {
          max-width: 520px;
        }

        .photo {
          min-height: 380px;
        }

        .cta {
          align-items: flex-start;
          flex-direction: column;
        }
      }

      @media (max-width: 575px) {
        .nav,
        .hero,
        .section,
        .footer {
          width: 100%;
          max-width: 100vw;
          overflow-x: hidden;
        }

        .containerx {
          width: calc(100% - 30px);
          max-width: calc(100vw - 30px);
        }

        .nav-inner {
          min-height: 68px;
          gap: 10px;
        }

        .logo .brand-logo-img {
          width: 118px;
        }

        .landing-logo img {
          width: 118px;
        }

        .nav-cta {
          display: none;
        }

        .hero {
          min-height: auto;
          padding: 104px 0 56px;
        }

        .hero-grid {
          display: block;
          width: calc(100% - 30px);
          max-width: calc(100vw - 30px);
        }

        .hero-grid > * {
          width: 100%;
          max-width: 100%;
          min-width: 0;
        }

        .hero h1 {
          font-size: 32px;
          line-height: 1.12;
          width: 100%;
          max-width: 330px;
          word-break: normal;
          overflow-wrap: anywhere;
        }

        .hero p {
          font-size: 16px;
          width: 100%;
          max-width: 330px;
        }

        .mockup {
          max-width: 100%;
          padding: 14px;
        }

        .mockup-screen {
          padding: 16px;
        }

        .mockup-top,
        .schedule-row,
        .check {
          min-width: 0;
        }

        .mockup-title,
        .schedule-row div,
        .check div {
          min-width: 0;
        }

        .mockup-title strong,
        .mockup-title span,
        .schedule-row strong,
        .schedule-row span,
        .check strong,
        .check span {
          overflow-wrap: anywhere;
        }

        .section {
          padding: 60px 0;
        }

        .section-head h2,
        .cta h2 {
          font-size: 30px;
        }

        .actions .btnx,
        .cta .btnx {
          width: 100%;
        }

        .metric-grid {
          grid-template-columns: 1fr;
        }

        .preview-grid {
          grid-template-columns: 1fr;
        }

        .footer-inner {
          grid-template-columns: 1fr;
        }

        .footer-brand {
          padding: 22px;
        }

        .footer-brand p {
          max-width: none;
          margin-bottom: 18px;
        }

        .footer-columns {
          grid-template-columns: 1fr;
          gap: 12px;
        }

        .footer-column {
          padding: 18px;
        }

        .footer-column a {
          min-height: 34px;
          justify-content: flex-start;
        }

        .footer-column a i {
          margin-left: auto;
        }

        .payment-grid {
          grid-template-columns: repeat(4, minmax(0, 1fr));
          gap: 6px;
        }

        .footer-payments {
          padding: 18px;
        }

        .link-card {
          min-height: 210px;
        }

        .payment-grid img {
          height: 32px;
        }

        .footer-bottom-inner {
          width: calc(100% - 30px);
          gap: 10px;
        }

        .footer-inner,
        .footer-bottom-inner {
          align-items: flex-start;
          flex-direction: column;
        }

        .footer-meta {
          width: 100%;
          flex-direction: column;
          align-items: flex-start;
          gap: 6px;
          line-height: 1.55;
        }

        .footer-meta span,
        .footer-meta a,
        .footer-copy {
          max-width: 100%;
          overflow-wrap: anywhere;
        }
      }
    </style>
  </head>
  <body>
    <% const data = landingData; const dashboardHref = data.currentUser ? '/dashboard' : '/sign-in'; %>

    <div class="site">
      <nav class="nav">
        <div class="containerx nav-inner">
          <a href="/" class="landing-logo" aria-label="FitAccess Home">
            <img src="/images/logo/logo.svg" alt="FitAccess" />
          </a>

          <div class="links nav-links">
            <div class="link-box"><a href="#plans">Plans</a></div>
            <div class="link-box"><a href="#nutrition">Nutrition</a></div>
            <div class="link-box"><a href="#experience">Experience</a></div>
            <div class="link-box"><a href="#access">Access</a></div>
            <div class="link-box nav-cta">
              <a href="<%= dashboardHref %>" class="btnx btn-primaryx">
                <%= data.currentUser ? 'Dashboard' : 'Sign In' %>
              </a>
            </div>
          </div>
        </div>
      </nav>

      <header class="hero">
        <div class="containerx hero-grid">
          <div>
            <div class="eyebrow">FitAccess Premium Membership</div>
            <h1>Personal fitness guidance from day one.</h1>
            <p>
              FitAccess gives members guided workouts, meal plans, progress tracking, protected account
              access, and an AI Coach experience in one clean fitness dashboard.
            </p>

            <div class="actions">
              <a href="<%= dashboardHref %>" class="btnx btn-primaryx">
                <i class="lni lni-rocket"></i>
                <%= data.currentUser ? 'Continue Your Plan' : 'Enter Member Area' %>
              </a>
            </div>
          </div>

          <div class="mockup" aria-label="FitAccess dashboard preview">
            <div class="mockup-screen">
              <div class="mockup-top">
                <div class="mockup-title">
                  <strong>Member Dashboard</strong>
                  <span>Workout, meals, and coaching in sync</span>
                </div>
                <span class="pill">Live Plan</span>
              </div>

              <div class="preview-card">
                <div class="preview-hero">
                  <div class="preview-hero-content">
                    <span>Today&apos;s Focus</span>
                    <strong>Strength session with high-protein meals.</strong>
                  </div>
                </div>

                <div class="preview-grid">
                  <div class="preview-panel">
                    <div class="progress-ring">
                      <div class="progress-ring-inner">74%</div>
                    </div>
                    <h4>Weekly Progress</h4>
                    <p>Workout streak, meal consistency, and weight tracking stay visible at a glance.</p>
                  </div>

                  <div class="preview-panel preview-list">
                    <div class="preview-item">
                      <span class="preview-icon"><i class="lni lni-dumbbell"></i></span>
                      <div>
                        <strong>Full Body Strength</strong>
                        <span>38 minute guided workout</span>
                      </div>
                    </div>
                    <div class="preview-item">
                      <span class="preview-icon"><i class="lni lni-dinner"></i></span>
                      <div>
                        <strong>Protein Bowl Plan</strong>
                        <span>Balanced meals for the day</span>
                      </div>
                    </div>
                    <div class="preview-item">
                      <span class="preview-icon"><i class="lni lni-comments-alt"></i></span>
                      <div>
                        <strong>AI Coach Ready</strong>
                        <span>Answers for workouts and meals</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </header>

      <section id="plans" class="section">
        <div class="containerx">
          <div class="section-head">
            <h2>Clear fitness plans for people who need direction, not confusion.</h2>
            <p>
              Members choose their goal, level, and training setup once. FitAccess gives them the next
              workout, meals, streaks, and progress cues without making the experience feel complicated.
            </p>
          </div>

          <div class="cards">
            <article class="cardx">
              <img src="https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?auto=format&fit=crop&w=900&q=86" alt="Member following a strength workout plan" />
              <div class="card-bodyx">
                <span class="iconx"><i class="lni lni-dumbbell"></i></span>
                <h3>Workout Programs</h3>
                <p>Beginner, intermediate, and advanced plans for home or gym training, with practical exercises and completion tracking.</p>
              </div>
            </article>

            <article id="nutrition" class="cardx">
              <img src="https://images.unsplash.com/photo-1498837167922-ddd27525d352?auto=format&fit=crop&w=900&q=86" alt="Healthy meal prep ingredients for a weekly plan" />
              <div class="card-bodyx">
                <span class="iconx"><i class="lni lni-dinner"></i></span>
                <h3>Meal Guidance</h3>
                <p>Weekly meals, recipes, calories, macros, and shopping support for weight loss, muscle gain, or general fitness.</p>
              </div>
            </article>

            <article class="cardx">
              <img src="https://images.unsplash.com/photo-1512428559087-560fa5ceab42?auto=format&fit=crop&w=900&q=86" alt="Member checking guided fitness support on a phone" />
              <div class="card-bodyx">
                <span class="iconx"><i class="lni lni-comments-alt"></i></span>
                <h3>AI Coach</h3>
                <p>Fast answers for workouts, meals, macros, hydration, and consistency inside a polished chat experience.</p>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section id="experience" class="section section-dark">
        <div class="containerx split">
          <div class="photo" role="img" aria-label="Healthy meal preparation"></div>

          <div>
            <div class="section-head">
              <h2>Designed to feel useful from day one.</h2>
              <p>
                The app helps members find what to do next quickly, stay consistent, and manage their
                account without feeling lost inside a complicated tool.
              </p>
            </div>

            <div class="checks">
              <div class="check">
                <i class="lni lni-checkmark-circle"></i>
                <div>
                  <strong>Quick account access</strong>
                  <span>Members receive a clean access email and can start without extra signup friction.</span>
                </div>
              </div>

              <div class="check">
                <i class="lni lni-checkmark-circle"></i>
                <div>
                  <strong>Protected member access</strong>
                  <span>Members complete checkout before entry, then continue through a secure account area without extra payment steps inside the app.</span>
                </div>
              </div>

              <div class="check">
                <i class="lni lni-checkmark-circle"></i>
                <div>
                  <strong>Visible progress</strong>
                  <span>Workout completions, streaks, weight logs, and activity history keep the product feeling active.</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="containerx">
          <div class="section-head">
            <h2>A simple fitness routine members can follow every day.</h2>
            <p>FitAccess keeps the member experience direct: open the dashboard, follow the plan, ask the coach, and track progress.</p>
          </div>

          <div class="steps">
            <div class="step">
              <span>1</span>
              <h3>Open Your Plan</h3>
              <p>The dashboard shows today's workout, meals, streak, and the next best action.</p>
            </div>

            <div class="step">
              <span>2</span>
              <h3>Train With Focus</h3>
              <p>Home and gym workouts are organized by goal, level, week, and training day.</p>
            </div>

            <div class="step">
              <span>3</span>
              <h3>Eat With Clarity</h3>
              <p>Meal guidance keeps calories, macros, and recipe ideas simple enough to follow.</p>
            </div>

            <div class="step">
              <span>4</span>
              <h3>Keep Momentum</h3>
              <p>Progress logs, activity history, and AI Coach prompts help members stay consistent.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="section section-dark">
        <div class="containerx">
          <div class="section-head">
            <h2>Everything important, one tap away.</h2>
            <p>Members can move straight into the area they need without digging through menus.</p>
          </div>

          <div class="link-hub">
            <a href="<%= dashboardHref %>" class="link-card">
              <span class="link-card-icon"><i class="lni lni-grid-alt"></i></span>
              <strong>Member Dashboard</strong>
              <p>Continue your daily plan, check your streak, and see what needs attention next.</p>
              <span>Open dashboard <i class="lni lni-arrow-right"></i></span>
            </a>

            <a href="#plans" class="link-card">
              <span class="link-card-icon"><i class="lni lni-dumbbell"></i></span>
              <strong>Workout Plans</strong>
              <p>Review guided training for home or gym, matched to your level and goal.</p>
              <span>View training <i class="lni lni-arrow-right"></i></span>
            </a>

            <a href="#nutrition" class="link-card">
              <span class="link-card-icon"><i class="lni lni-dinner"></i></span>
              <strong>Nutrition Guidance</strong>
              <p>Find meal direction, recipe support, macros, and shopping help in one place.</p>
              <span>See nutrition <i class="lni lni-arrow-right"></i></span>
            </a>

            <a href="#access" class="link-card">
              <span class="link-card-icon"><i class="lni lni-lock-alt"></i></span>
              <strong>Account Access</strong>
              <p>Sign in or recover access so you can get back to your fitness plan quickly.</p>
              <span>Manage access <i class="lni lni-arrow-right"></i></span>
            </a>
          </div>
        </div>
      </section>

      <section id="access" class="section section-soft">
        <div class="containerx cta">
          <div>
            <h2>Already have FitAccess?</h2>
            <p>Sign in or reset your password to continue your personalized plan.</p>
          </div>

          <div class="actions">
            <a href="/sign-in" class="btnx btn-primaryx">Sign In</a>
            <a href="/forgot-password" class="btnx btn-outlinex">Reset Password</a>
          </div>
        </div>
      </section>

      <footer class="footer">
        <div class="containerx footer-inner">
          <div class="footer-brand">
            <a href="/" class="footer-logo" aria-label="FitAccess Home">
              <img src="/images/logo/logo-white.svg" alt="FitAccess" />
            </a>
            <p>
              Premium fitness membership with guided training, practical nutrition, progress tracking,
              and helpful AI Coach support.
            </p>

            <div class="footer-badges">
              <div class="footer-badge">
                <i class="lni lni-shield"></i>
                <span>Secure member access</span>
              </div>
              <div class="footer-badge">
                <i class="lni lni-bolt-alt"></i>
                <span>Built for daily consistency</span>
              </div>
            </div>
          </div>

          <div class="footer-right">
            <div class="footer-columns">
              <div class="footer-column">
                <h3>Account</h3>
                <a href="/sign-in">Sign In <i class="lni lni-arrow-right"></i></a>
                <a href="/forgot-password">Reset Password <i class="lni lni-arrow-right"></i></a>
              </div>

              <div class="footer-column">
                <h3>Quick Links</h3>
                <a href="#access">Account Access <i class="lni lni-arrow-right"></i></a>
                <a href="/">Home <i class="lni lni-arrow-right"></i></a>
                <% if (data.currentUser?.role === 'admin') { %>
                  <a href="<%= adminBasePath || '/panel' %>">Admin Panel <i class="lni lni-arrow-right"></i></a>
                <% } %>
              </div>

              <div class="footer-column">
                <h3>Legal</h3>
                <a href="/terms-and-conditions">Terms and Conditions <i class="lni lni-arrow-right"></i></a>
                <a href="/privacy-policy">Privacy Policy <i class="lni lni-arrow-right"></i></a>
                <a href="/refund-policy">Refund Policy <i class="lni lni-arrow-right"></i></a>
                <a href="/do-not-sell-or-share">Do Not Sell or Share My Personal Information <i class="lni lni-arrow-right"></i></a>
              </div>
            </div>

            <div class="footer-payments">
              <p class="payment-title">Accepted payment methods</p>
              <div class="payment-grid" aria-label="Accepted payment brands">
                <img src="/images/payment-brands/visa.svg" alt="Visa" />
                <img src="/images/payment-brands/mastercard.svg" alt="Mastercard" />
                <img src="/images/payment-brands/amex.svg" alt="American Express" />
                <img src="/images/payment-brands/discover.svg" alt="Discover" />
                <img src="/images/payment-brands/jcb.svg" alt="JCB" />
                <img src="/images/payment-brands/diners.svg" alt="Diners Club" />
                <img src="/images/payment-brands/unionpay.svg" alt="UnionPay" />
                <img src="/images/payment-brands/maestro.svg" alt="Maestro" />
              </div>
            </div>
          </div>
        </div>

        <div class="footer-bottom">
          <div class="footer-bottom-inner">
            <div class="footer-meta">
              <span class="footer-tagline" style="color: #94a3b8 !important; font-weight: 400;">FitAccess helps members stay consistent with fitness, meals, and progress in one secure account.</span>
              <% if (data.supportEmail) { %>
                <a href="mailto:<%= data.supportEmail %>">Support: <%= data.supportEmail %></a>
              <% } %>
            </div>
            <span class="footer-copy">© <span id="footer-year"></span> FitAccess</span>
          </div>
        </div>
      </footer>
    </div>

    <script src="/js/bootstrap.bundle.min.js"></script>
    <script>
      document.getElementById('footer-year').textContent = new Date().getFullYear();
    </script>
  </body>
</html>
