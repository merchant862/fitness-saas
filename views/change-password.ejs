<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head.ejs') %>
    <title>FitAccess | Change Password</title>
  </head>
  <body>
    <% const data = changePasswordData; %>

    <!-- ======== Preloader =========== -->
    <%- include('partials/spinner.ejs') %>
    <!-- ======== Preloader =========== -->

    <!-- ======== sidebar-nav start =========== -->
    <%- include('partials/sidebar.ejs', { activePage: 'profile' }) %>
    <!-- ======== sidebar-nav end =========== -->

    <!-- ======== main-wrapper start =========== -->
    <main class="main-wrapper">
      <%- include('partials/header.ejs', {
        pageTitle: 'Change Password',
        pageSubtitle: 'Update your account password securely.',
        currentUser: data.currentUser
      }) %>

      <section class="section">
        <div class="container-fluid">
          <div class="row justify-content-center pt-30">
            <div class="col-xl-7 col-lg-8">
              <div class="card-style mb-30">
                <div class="title mb-25">
                  <h2>Change Password</h2>
                  <p class="text-sm mt-10 mb-0">
                    Update your password for better account security.
                  </p>
                </div>

                <form action="#" method="POST">
                  <div class="input-style-1">
                    <label>Current Password</label>
                    <input type="password" name="currentPassword" placeholder="Enter current password" />
                  </div>

                  <div class="input-style-1">
                    <label>New Password</label>
                    <input type="password" name="newPassword" placeholder="Enter new password" />
                  </div>

                  <div class="input-style-1">
                    <label>Confirm New Password</label>
                    <input type="password" name="confirmPassword" placeholder="Confirm new password" />
                  </div>

                  <p class="text-sm mb-25"><%= data.note %></p>

                  <div class="d-flex justify-content-end gap-2">
                    <a href="/profile" class="main-btn light-btn btn-hover">
                      Cancel
                    </a>
                    <button type="button" class="main-btn primary-btn btn-hover">
                      Update Password
                    </button>
                  </div>
                </form>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <%- include('partials/scripts.ejs') %>
  </body>
</html>