<%
  const avatarGender = String(currentUser?.gender || currentUser?.profile?.preferences?.gender || '').toLowerCase();
  const avatarType = avatarGender === 'male' || avatarGender === 'female' || avatarGender === 'other' ? avatarGender : 'guest';
  const avatarLabel = avatarType === 'male' ? 'Male profile' : avatarType === 'female' ? 'Female profile' : avatarType === 'other' ? 'Other profile' : 'Guest profile';
  const avatarGlyph = avatarType === 'male' ? '♂' : avatarType === 'female' ? '♀' : avatarType === 'other' ? '⚧' : null;
  const isAdminPanel = currentUser?.role === 'admin';
  const displayName = currentUser?.name || currentUser?.email || 'User';
%>
<header class="header">
  <div class="container-fluid">
    <div class="row">
      <div class="col-lg-6 col-md-6 col-6">
        <div class="header-left d-flex align-items-center">
          <div class="menu-toggle-btn mr-15">
            <button id="menu-toggle" class="main-btn primary-btn btn-hover">
              <i class="lni lni-chevron-left me-2"></i> Menu
            </button>
          </div>

          <div class="d-none d-md-block">
            <h6 class="mb-0"><%= pageTitle || 'Dashboard' %></h6>
            <p class="text-sm mb-0">
              <%= pageSubtitle || 'Stay consistent and keep moving forward.' %>
            </p>
          </div>
        </div>
      </div>

      <div class="col-lg-6 col-md-6 col-6">
        <div class="header-right d-flex align-items-center justify-content-end">

          <!-- theme toggle start -->
          <div class="me-3">
            <button
              id="theme-toggle"
              type="button"
              class="theme-toggle-switch"
              aria-label="Toggle theme"
              title="Toggle dark/light mode"
            >
              <span id="theme-toggle-light" class="theme-toggle-option">Light</span>
              <span id="theme-toggle-dark" class="theme-toggle-option">Dark</span>
            </button>
          </div>
          <!-- theme toggle end -->

          <div class="profile-box ml-15">
            <button
              class="dropdown-toggle bg-transparent border-0"
              type="button"
              id="profile"
              data-bs-toggle="dropdown"
              aria-expanded="false"
            >
              <div class="profile-info">
                <div class="info">
                  <div class="image profile-avatar profile-avatar--<%= avatarType %>" aria-label="<%= avatarLabel %>">
                    <% if (avatarGlyph) { %>
                      <span class="profile-avatar-glyph"><%= avatarGlyph %></span>
                    <% } else { %>
                      <i class="lni lni-user"></i>
                    <% } %>
                  </div>
                  <div>
                    <h6 class="fw-500"><%= displayName %></h6>
                    <p><%= isAdminPanel ? 'Admin Panel' : (currentUser?.goal || 'Fitness Plan') %></p>
                  </div>
                </div>
              </div>
            </button>

            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="profile">
              <li>
                <div class="author-info flex items-center !p-1">
                  <div class="image profile-avatar profile-avatar--<%= avatarType %>" aria-label="<%= avatarLabel %>">
                    <% if (avatarGlyph) { %>
                      <span class="profile-avatar-glyph"><%= avatarGlyph %></span>
                    <% } else { %>
                      <i class="lni lni-user"></i>
                    <% } %>
                  </div>
                  <div class="content">
                    <h4 class="text-sm"><%= displayName %></h4>
                    <p class="text-xs mb-0"><%= isAdminPanel ? 'Administrator' : 'Member' %></p>
                  </div>
                </div>
              </li>

              <li class="divider"></li>

              <% if (!isAdminPanel) { %>
                <li>
                  <a href="/profile">
                    <i class="lni lni-user"></i> Profile
                  </a>
                </li>

                <li>
                  <a href="/progress">
                    <i class="lni lni-bar-chart"></i> Progress
                  </a>
                </li>

                <li>
                  <a href="/activity-log">
                    <i class="lni lni-timer"></i> Activity Log
                  </a>
                </li>

                <li>
                  <a href="/workouts">
                    <i class="lni lni-grid-alt"></i> Workouts
                  </a>
                </li>

                <li class="divider"></li>
              <% } %>

              <li>
                <a href="/change-password">
                 <i class="lni lni-lock-alt"></i> Change Password
                </a>
              </li>

              <li>
                <a href="/logout">
                 <i class="lni lni-exit"></i> Logout
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>
