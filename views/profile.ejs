<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head.ejs') %>
    <title>FitAccess | Profile</title>
  </head>
  <body>
    <% const data = profileData; %>

    <!-- ======== Preloader =========== -->
    <%- include('partials/spinner.ejs') %>
    <!-- ======== Preloader =========== -->

    <!-- ======== sidebar-nav start =========== -->
    <%- include('partials/sidebar.ejs', { activePage: 'profile' }) %>
    <!-- ======== sidebar-nav end =========== -->

    <!-- ======== main-wrapper start =========== -->
    <main class="main-wrapper">
      <!-- ========== header start ========== -->
      <%- include('partials/header.ejs', {
        pageTitle: 'Profile',
        pageSubtitle: 'Manage your fitness profile and account settings.',
        currentUser: data.currentUser
      }) %>
      <!-- ========== header end ========== -->

      <!-- ========== section start ========== -->
      <section class="section">
        <div class="container-fluid">
          <!-- ========== title-wrapper start ========== -->
          <div class="title-wrapper pt-30">
            <div class="row align-items-center">
              <div class="col-md-8">
                <div class="title">
                  <h2>My Profile</h2>
                  <p class="text-sm text-medium">
                    Keep your profile updated so your plan stays personalized.
                  </p>
                </div>
              </div>
              <div class="col-md-4">
                <div class="breadcrumb-wrapper">
                  <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                      <li class="breadcrumb-item">
                        <a href="/dashboard">Home</a>
                      </li>
                      <li class="breadcrumb-item active" aria-current="page">
                        Profile
                      </li>
                    </ol>
                  </nav>
                </div>
              </div>
            </div>
          </div>
          <!-- ========== title-wrapper end ========== -->

          <!-- ========== top cards start ========== -->
          <div class="row">
            <div class="col-xl-4 col-lg-4 col-sm-6">
              <div class="icon-card mb-30">
                <div class="icon primary">
                  <i class="lni lni-user"></i>
                </div>
                <div class="content">
                  <h6 class="mb-10">Goal</h6>
                  <h3 class="text-bold mb-10"><%= data.currentUser.goal %></h3>
                  <p class="text-sm text-gray">Your selected fitness goal</p>
                </div>
              </div>
            </div>

            <div class="col-xl-4 col-lg-4 col-sm-6">
              <div class="icon-card mb-30">
                <div class="icon success">
                  <i class="lni lni-target"></i>
                </div>
                <div class="content">
                  <h6 class="mb-10">Current Setup</h6>
                  <h3 class="text-bold mb-10"><%= data.currentUser.level %></h3>
                  <p class="text-sm text-gray"><%= data.currentUser.environment %> workouts</p>
                </div>
              </div>
            </div>

            <div class="col-xl-4 col-lg-4 col-sm-6">
              <div class="icon-card mb-30">
                <div class="icon orange">
                  <i class="lni lni-lock-alt"></i>
                </div>
                <div class="content">
                  <h6 class="mb-10">Access Status</h6>
                  <h3 class="text-bold mb-10"><%= data.profile.accessStatus %></h3>
                  <p class="text-sm text-gray"><%= data.profile.membership %></p>
                </div>
              </div>
            </div>
          </div>
          <!-- ========== top cards end ========== -->

          <!-- ========== profile form + summary start ========== -->
          <% if (data.message) { %>
            <div class="alert-box success-alert mb-25">
              <p class="text-sm mb-0"><%= data.message %></p>
            </div>
          <% } %>

          <% if (data.billingMessage) { %>
            <div class="alert-box <%= data.billingMessage.type === 'success' ? 'success-alert' : 'danger-alert' %> mb-25">
              <p class="text-sm mb-0"><%= data.billingMessage.text %></p>
            </div>
          <% } %>

          <div class="row">
            <div class="col-lg-8">
              <div class="card-style mb-30">
                <div class="title">
                  <h6 class="text-medium mb-20">Profile Details</h6>
                </div>

                <form action="/profile" method="POST">
                  <div class="row">
                    <div class="col-md-6">
                      <div class="input-style-1">
                        <label>Full Name</label>
                        <input type="text" name="name" value="<%= data.currentUser.name %>" />
                      </div>
                    </div>

                    <div class="col-md-6">
                      <div class="input-style-1">
                        <label>Email</label>
                        <input type="email" value="<%= data.currentUser.email %>" disabled />
                      </div>
                    </div>

                    <div class="col-md-4">
                      <div class="input-style-1">
                        <label>Age</label>
                        <input type="number" name="age" min="1" max="120" value="<%= data.profile.age %>" />
                      </div>
                    </div>

                    <div class="col-md-4">
                      <div class="input-style-1">
                        <label>Gender</label>
                        <input type="text" name="gender" value="<%= data.profile.gender %>" />
                      </div>
                    </div>

                    <div class="col-md-4">
                      <div class="input-style-1">
                        <label>Height</label>
                        <input type="text" name="height" value="<%= data.profile.height %>" />
                      </div>
                    </div>

                    <div class="col-md-4">
                      <div class="input-style-1">
                        <label>Current Weight (kg)</label>
                        <input type="number" name="currentWeight" min="1" step="0.1" value="<%= data.profile.currentWeight %>" />
                      </div>
                    </div>

                    <div class="col-md-4">
                      <div class="input-style-1">
                        <label>Target Weight (kg)</label>
                        <input type="number" name="targetWeight" min="1" step="0.1" value="<%= data.profile.targetWeight %>" />
                      </div>
                    </div>

                    <div class="col-md-4">
                      <div class="input-style-1">
                        <label>Workout Days / Week</label>
                        <input type="number" name="workoutDays" min="1" max="7" value="<%= data.profile.workoutDays %>" />
                      </div>
                    </div>

                    <div class="col-md-4">
                      <div class="select-style-1">
                        <label>Goal</label>
                        <div class="select-position">
                          <select name="goal">
                            <option value="weight_loss" <%= data.currentUser.goal === 'Weight Loss' ? 'selected' : '' %>>Weight Loss</option>
                            <option value="muscle_gain" <%= data.currentUser.goal === 'Muscle Gain' ? 'selected' : '' %>>Muscle Gain</option>
                            <option value="general_fitness" <%= data.currentUser.goal === 'General Fitness' ? 'selected' : '' %>>General Fitness</option>
                          </select>
                        </div>
                      </div>
                    </div>

                    <div class="col-md-4">
                      <div class="select-style-1">
                        <label>Level</label>
                        <div class="select-position">
                          <select name="level">
                            <option value="beginner" <%= data.currentUser.level === 'Beginner' ? 'selected' : '' %>>Beginner</option>
                            <option value="intermediate" <%= data.currentUser.level === 'Intermediate' ? 'selected' : '' %>>Intermediate</option>
                            <option value="advanced" <%= data.currentUser.level === 'Advanced' ? 'selected' : '' %>>Advanced</option>
                          </select>
                        </div>
                      </div>
                    </div>

                    <div class="col-md-4">
                      <div class="select-style-1">
                        <label>Environment</label>
                        <div class="select-position">
                          <select name="environment">
                            <option value="home" <%= data.currentUser.environment === 'Home' ? 'selected' : '' %>>Home</option>
                            <option value="gym" <%= data.currentUser.environment === 'Gym' ? 'selected' : '' %>>Gym</option>
                          </select>
                        </div>
                      </div>
                    </div>
                  </div>

                  <div class="d-flex justify-content-end">
                    <button type="submit" class="main-btn primary-btn btn-hover">
                      Save Changes
                    </button>
                  </div>
                </form>
              </div>
            </div>

            <div class="col-lg-4">
              <div class="card-style mb-30">
                <div class="title">
                  <h6 class="text-medium mb-20">Profile Summary</h6>
                </div>

                <p class="text-sm mb-10"><strong>Name:</strong> <%= data.currentUser.name %></p>
                <p class="text-sm mb-10"><strong>Email:</strong> <%= data.currentUser.email %></p>
                <p class="text-sm mb-10"><strong>Membership:</strong> <%= data.profile.membership %></p>
                <p class="text-sm mb-10"><strong>Joined:</strong> <%= data.profile.joinedAt %></p>
                <p class="text-sm mb-10"><strong>Goal:</strong> <%= data.currentUser.goal %></p>
                <p class="text-sm mb-10"><strong>Level:</strong> <%= data.currentUser.level %></p>
                <p class="text-sm mb-0"><strong>Environment:</strong> <%= data.currentUser.environment %></p>
              </div>

              <div class="card-style mb-30">
                <div class="title">
                  <h6 class="text-medium mb-20">Billing</h6>
                </div>

                <% if (data.billing.cardLast4) { %>
                  <p class="text-sm mb-10"><strong>Card:</strong> **** **** **** <%= data.billing.cardLast4 %></p>
                <% } else { %>
                  <p class="text-sm mb-10"><strong>Card:</strong> Not added</p>
                <% } %>

                <p class="text-sm mb-20">
                  <strong>Next Charge:</strong>
                  <%= data.billing.nextChargeAt || 'Pending' %>
                </p>

                <div class="billing-brand-row mb-20" aria-label="Accepted cards">
                  <span class="billing-brand visa">VISA</span>
                  <span class="billing-brand mastercard">Mastercard</span>
                  <span class="billing-brand amex">AMEX</span>
                  <span class="billing-brand discover">Discover</span>
                </div>

                <form action="/billing/payment-method" method="POST" autocomplete="on">
                  <input type="hidden" name="returnTo" value="/profile" />

                  <div class="input-style-1">
                    <label>Name on Card</label>
                    <input type="text" name="cardHolderName" autocomplete="cc-name" required />
                  </div>

                  <div class="input-style-1">
                    <label>Card Number</label>
                    <input type="text" name="cardNumber" inputmode="numeric" autocomplete="cc-number" maxlength="23" required />
                  </div>

                  <div class="row">
                    <div class="col-4">
                      <div class="input-style-1">
                        <label>Month</label>
                        <input type="text" name="expiryMonth" inputmode="numeric" autocomplete="cc-exp-month" maxlength="2" required />
                      </div>
                    </div>

                    <div class="col-4">
                      <div class="input-style-1">
                        <label>Year</label>
                        <input type="text" name="expiryYear" inputmode="numeric" autocomplete="cc-exp-year" maxlength="4" required />
                      </div>
                    </div>

                    <div class="col-4">
                      <div class="input-style-1">
                        <label>CVV</label>
                        <input type="password" name="cvv" inputmode="numeric" autocomplete="cc-csc" maxlength="4" required />
                      </div>
                    </div>
                  </div>

                  <button type="submit" class="main-btn primary-btn btn-hover w-100">
                    Update Card
                  </button>
                </form>
              </div>

              <div class="card-style mb-30">
                <div class="title">
                  <h6 class="text-medium mb-20">Activity Snapshot</h6>
                </div>

                <p class="text-sm mb-10"><strong>Streak:</strong> <%= data.stats.streakDays %> days</p>
                <p class="text-sm mb-10"><strong>Workouts Completed:</strong> <%= data.stats.workoutsCompleted %></p>
                <p class="text-sm mb-0"><strong>Meals Followed:</strong> <%= data.stats.mealsFollowed %></p>
              </div>

              <div class="card-style mb-30">
                <div class="title">
                  <h6 class="text-medium mb-20">Profile Note</h6>
                </div>

                <p class="text-sm mb-0"><%= data.note %></p>
              </div>
            </div>
          </div>
          <!-- ========== profile form + summary end ========== -->
        </div>
      </section>
      <!-- ========== section end ========== -->
    </main>
    <!-- ======== main-wrapper end =========== -->

    <%- include('partials/scripts.ejs') %>
  </body>
</html>
