<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../partials/head.ejs') %>
    <title>FitAccess | Admin Users</title>
  </head>
  <body>
    <% const data = adminData; const adminPath = typeof adminBasePath === 'string' ? adminBasePath : '/panel'; const adminApiPathValue = typeof adminApiPath === 'string' ? adminApiPath : '/api/panel'; const pagination = data.pagination || { total: data.users.length, limit: data.filters.limit || 25, offset: data.filters.offset || 0 }; %>
    <%- include('../partials/spinner.ejs') %>
    <%- include('../partials/admin-sidebar.ejs', { activePage: 'admin-users' }) %>

    <main class="main-wrapper">
      <%- include('../partials/header.ejs', {
        pageTitle: 'Users',
        pageSubtitle: 'Manage customer access and account status.',
        currentUser: data.currentUser
      }) %>

      <section class="section">
        <div class="container-fluid">
          <div class="title-wrapper pt-30">
            <div class="row align-items-center">
              <div class="col-md-8">
                <div class="title">
                  <h2>Users</h2>
                  <p class="text-sm text-medium" id="admin-users-count"><%= pagination.total > data.users.length ? `${pagination.offset + 1}-${pagination.offset + data.users.length} of ${pagination.total} users shown.` : `${data.users.length} users shown.` %></p>
                </div>
              </div>
              <div class="col-md-4">
                <div class="breadcrumb-wrapper">
                  <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                      <li class="breadcrumb-item"><a href="<%= adminPath %>">Admin</a></li>
                      <li class="breadcrumb-item active" aria-current="page">Users</li>
                    </ol>
                  </nav>
                </div>
              </div>
            </div>
          </div>

          <div class="card-style mb-25">
            <form action="<%= adminPath %>/users" method="GET" id="admin-users-filter" data-admin-users-api="<%= adminApiPathValue %>/users" data-admin-users-limit="<%= pagination.limit %>" data-admin-users-offset="<%= pagination.offset %>">
              <div class="row align-items-end">
                <div class="col-lg-4 col-md-6">
                  <div class="input-style-1 mb-0">
                    <label>Search Email</label>
                    <input type="search" name="search" value="<%= data.filters.search %>" placeholder="customer@example.com" autocomplete="off" />
                  </div>
                </div>

                <div class="col-lg-2 col-md-6">
                  <div class="select-style-1 mb-0">
                    <label>Status</label>
                    <div class="select-position">
                      <select name="status">
                        <option value="">All</option>
                        <option value="active" <%= data.filters.status === 'active' ? 'selected' : '' %>>Active</option>
                        <option value="pending" <%= data.filters.status === 'pending' ? 'selected' : '' %>>Pending</option>
                        <option value="suspended" <%= data.filters.status === 'suspended' ? 'selected' : '' %>>Suspended</option>
                      </select>
                    </div>
                  </div>
                </div>

                <div class="col-lg-3 col-md-6">
                  <div class="select-style-1 mb-0">
                    <label>Goal</label>
                    <div class="select-position">
                      <select name="goal">
                        <option value="">All</option>
                        <option value="weight_loss" <%= data.filters.goal === 'weight_loss' ? 'selected' : '' %>>Weight Loss</option>
                        <option value="muscle_gain" <%= data.filters.goal === 'muscle_gain' ? 'selected' : '' %>>Muscle Gain</option>
                        <option value="general_fitness" <%= data.filters.goal === 'general_fitness' ? 'selected' : '' %>>General Fitness</option>
                      </select>
                    </div>
                  </div>
                </div>

                <div class="col-lg-3 col-md-6">
                  <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="main-btn primary-btn btn-hover btn-sm">Filter</button>
                    <a href="<%= adminPath %>/users" class="main-btn light-btn btn-hover btn-sm">Clear</a>
                    <a href="<%= adminPath %>/users/export.csv?search=<%= encodeURIComponent(data.filters.search) %>&status=<%= encodeURIComponent(data.filters.status) %>&goal=<%= encodeURIComponent(data.filters.goal) %>" class="main-btn success-btn btn-hover btn-sm" id="admin-users-export">Export CSV</a>
                  </div>
                </div>
              </div>
            </form>
          </div>

          <div class="card-style mb-30">
            <div class="table-wrapper table-responsive">
              <table class="table">
                <thead>
                  <tr>
                    <th><h6>Email</h6></th>
                    <th><h6>Status</h6></th>
                    <th><h6>Goal</h6></th>
                    <th><h6>Access Expires</h6></th>
                    <th><h6>Joined</h6></th>
                    <th><h6>Actions</h6></th>
                  </tr>
                </thead>
                <tbody id="admin-users-table-body" data-admin-path="<%= adminPath %>">
                  <% if (!data.users.length) { %>
                    <tr><td colspan="6"><p class="text-sm mb-0">No users found.</p></td></tr>
                  <% } %>
                  <% data.users.forEach(function(user) { %>
                    <tr>
                      <td><p class="text-sm mb-0"><%= user.email %></p></td>
                      <td>
                        <span class="status-btn <%= user.status === 'active' ? 'success-btn' : (user.status === 'suspended' ? 'close-btn' : 'warning-btn') %>"><%= user.status %></span>
                      </td>
                      <td><p class="text-sm mb-0"><%= user.profile?.goal || '-' %></p></td>
                      <td><p class="text-sm mb-0"><%= user.accessExpiresAt ? user.accessExpiresAt.toLocaleDateString() : '-' %></p></td>
                      <td><p class="text-sm mb-0"><%= user.createdAt.toLocaleDateString() %></p></td>
                      <td>
                        <form action="<%= adminPath %>/users/<%= user.id %>/status" method="POST" class="d-flex gap-2 align-items-center" data-ajax="false">
                          <div class="select-style-1 mb-0" style="min-width: 135px;">
                            <div class="select-position">
                              <select name="status" aria-label="Account status">
                                <option value="active" <%= user.status === 'active' ? 'selected' : '' %>>Active</option>
                                <option value="pending" <%= user.status === 'pending' ? 'selected' : '' %>>Pending</option>
                                <option value="suspended" <%= user.status === 'suspended' ? 'selected' : '' %>>Suspended</option>
                              </select>
                            </div>
                          </div>
                          <button type="submit" class="main-btn light-btn btn-hover btn-sm">Update</button>
                        </form>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 pt-25">
              <p class="text-sm text-medium mb-0" id="admin-users-page-label">
                Page <%= Math.floor(pagination.offset / pagination.limit) + 1 %>
              </p>
              <div class="d-flex flex-wrap gap-2">
                <button type="button" class="main-btn light-btn btn-hover btn-sm" id="admin-users-prev" <%= pagination.offset <= 0 ? 'disabled' : '' %>>Previous</button>
                <button type="button" class="main-btn primary-btn btn-hover btn-sm" id="admin-users-next" <%= pagination.offset + data.users.length >= pagination.total ? 'disabled' : '' %>>Next</button>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <%- include('../partials/scripts.ejs') %>
    <script src="/js/admin-users.js"></script>
  </body>
</html>
