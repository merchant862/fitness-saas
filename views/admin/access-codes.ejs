<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../partials/head.ejs') %>
    <title>FitAccess | Access Codes</title>
  </head>
  <body>
    <% const data = adminData; const adminPath = typeof adminBasePath === 'string' ? adminBasePath : '/panel'; %>
    <%- include('../partials/spinner.ejs') %>
    <%- include('../partials/admin-sidebar.ejs', { activePage: 'admin-access-codes' }) %>

    <main class="main-wrapper">
      <%- include('../partials/header.ejs', {
        pageTitle: 'Grant Access',
        pageSubtitle: 'Create customer access from the same fields used by checkout.',
        currentUser: data.currentUser
      }) %>

      <section class="section">
        <div class="container-fluid">
          <div class="title-wrapper pt-30">
            <div class="row align-items-center">
              <div class="col-md-8">
                <div class="title">
                  <h2>Grant Access</h2>
                  <p class="text-sm text-medium">Create a paid membership, save customer details, and queue the welcome email.</p>
                </div>
              </div>
              <div class="col-md-4">
                <div class="breadcrumb-wrapper">
                  <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                      <li class="breadcrumb-item"><a href="<%= adminPath %>">Admin</a></li>
                      <li class="breadcrumb-item active" aria-current="page">Grant Access</li>
                    </ol>
                  </nav>
                </div>
              </div>
            </div>
          </div>

          <% if (data.message) { %>
            <div class="alert-box success-alert mb-25">
              <p class="text-sm mb-0"><%= data.message %></p>
            </div>
          <% } %>
          <% if (data.error) { %>
            <div class="alert-box danger-alert mb-25">
              <p class="text-sm mb-0"><%= data.error %></p>
            </div>
          <% } %>

          <div class="row">
            <div class="col-12">
              <div class="card-style mb-30">
                <div class="title mb-20">
                  <h6 class="text-medium">Create Customer Access</h6>
                </div>
                <form action="<%= adminPath %>/access-codes/grant-access" method="POST" autocomplete="off">
                  <div class="row">
                    <div class="col-lg-4 col-md-6">
                      <div class="input-style-1">
                        <label>Email</label>
                        <input type="email" name="email" placeholder="customer@example.com" required />
                      </div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                      <div class="input-style-1">
                        <label>First Name</label>
                        <input type="text" name="firstName" placeholder="John" required />
                      </div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                      <div class="input-style-1">
                        <label>Last Name</label>
                        <input type="text" name="lastName" placeholder="Smith" required />
                      </div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                      <div class="input-style-1">
                        <label>Phone</label>
                        <input type="tel" name="phone" placeholder="+1 555 0100" />
                      </div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                      <div class="input-style-1">
                        <label>Address Line 1</label>
                        <input type="text" name="address1" placeholder="123 Market Street" required />
                      </div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                      <div class="input-style-1">
                        <label>Address Line 2</label>
                        <input type="text" name="address2" placeholder="Apt, suite, unit" />
                      </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                      <div class="input-style-1">
                        <label>City</label>
                        <input type="text" name="city" placeholder="Austin" required />
                      </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                      <div class="input-style-1">
                        <label>State</label>
                        <input type="text" name="state" placeholder="TX" required />
                      </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                      <div class="input-style-1">
                        <label>ZIP</label>
                        <input type="text" name="zip" placeholder="73301" required />
                      </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                      <div class="input-style-1">
                        <label>Country</label>
                        <input type="text" name="country" placeholder="US" required />
                      </div>
                    </div>
                  </div>

                  <div class="row">
                    <div class="col-lg-3 col-md-6">
                      <div class="input-style-1">
                        <label>Order ID</label>
                        <input type="text" name="orderId" placeholder="UPSELL-1001" required />
                      </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                      <div class="input-style-1">
                        <label>Parent Order ID</label>
                        <input type="text" name="parentOrderId" placeholder="FRONTSELL-9001" />
                      </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                      <div class="input-style-1">
                        <label>Funnel ID</label>
                        <input type="text" name="funnelId" placeholder="fitness-upsell" />
                      </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                      <div class="input-style-1">
                        <label>Access Days</label>
                        <input type="number" name="accessDays" min="1" max="3650" value="30" required />
                      </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                      <div class="input-style-1">
                        <label>Site ID</label>
                        <input type="text" name="siteId" placeholder="Response CRM site ID" />
                      </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                      <div class="input-style-1">
                        <label>Campaign ID</label>
                        <input type="text" name="campaignId" placeholder="Campaign ID" />
                      </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                      <div class="input-style-1">
                        <label>Product ID</label>
                        <input type="text" name="productId" placeholder="Product ID" required />
                      </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                      <div class="input-style-1">
                        <label>Offer ID</label>
                        <input type="text" name="offerId" placeholder="Offer ID" />
                      </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                      <div class="input-style-1">
                        <label>Amount</label>
                        <input type="number" name="amount" min="0" step="0.01" placeholder="29.99" required />
                      </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                      <div class="input-style-1">
                        <label>Currency</label>
                        <input type="text" name="currency" value="USD" maxlength="3" required />
                      </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                      <div class="input-style-1">
                        <label>CRM Customer ID</label>
                        <input type="text" name="customerId" placeholder="Optional" />
                      </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                      <div class="input-style-1">
                        <label>Next Charge Date</label>
                        <input type="date" name="nextChargedAt" />
                      </div>
                    </div>
                  </div>

                  <div class="row">
                    <div class="col-lg-4 col-md-6">
                      <div class="input-style-1">
                        <label>Name on Card</label>
                        <input type="text" name="cardHolderName" placeholder="John Smith" autocomplete="cc-name" required />
                      </div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                      <div class="input-style-1">
                        <label>Card Number</label>
                        <input type="text" name="cardNumber" inputmode="numeric" autocomplete="cc-number" placeholder="4111111111111111" required />
                      </div>
                    </div>
                    <div class="col-lg-2 col-md-6">
                      <div class="input-style-1">
                        <label>Exp Month</label>
                        <input type="text" name="expiryMonth" inputmode="numeric" autocomplete="cc-exp-month" placeholder="12" maxlength="2" required />
                      </div>
                    </div>
                    <div class="col-lg-2 col-md-6">
                      <div class="input-style-1">
                        <label>Exp Year</label>
                        <input type="text" name="expiryYear" inputmode="numeric" autocomplete="cc-exp-year" placeholder="2028" maxlength="4" required />
                      </div>
                    </div>
                    <div class="col-lg-2 col-md-6">
                      <div class="input-style-1">
                        <label>CVV</label>
                        <input type="password" name="cvv" inputmode="numeric" autocomplete="cc-csc" placeholder="123" maxlength="4" required />
                      </div>
                    </div>
                    <div class="col-lg-10 col-md-6 d-flex align-items-end justify-content-end">
                      <button type="submit" class="main-btn primary-btn btn-hover">Create Access</button>
                    </div>
                  </div>
                </form>
              </div>
            </div>

            <div class="col-12">
              <div class="card-style mb-30">
                <div class="title mb-20">
                  <h6 class="text-medium">Recent Access Codes</h6>
                </div>
                <div class="table-wrapper table-responsive">
                  <table class="table">
                    <thead>
                      <tr>
                        <th><h6>Email</h6></th>
                        <th><h6>Status</h6></th>
                        <th><h6>Expires</h6></th>
                        <th><h6>Redeemed</h6></th>
                        <th><h6>Actions</h6></th>
                      </tr>
                    </thead>
                    <tbody>
                      <% if (!data.accessCodes.length) { %>
                        <tr><td colspan="5"><p class="text-sm mb-0">No access codes found.</p></td></tr>
                      <% } %>
                      <% data.accessCodes.forEach(function(code) { %>
                        <tr>
                          <td><p class="text-sm mb-0"><%= code.email %></p></td>
                          <td><span class="status-btn <%= code.status === 'redeemed' ? 'success-btn' : (code.status === 'unused' ? 'primary-btn' : 'close-btn') %>"><%= code.status %></span></td>
                          <td><p class="text-sm mb-0"><%= code.expiresAt.toLocaleDateString() %></p></td>
                          <td><p class="text-sm mb-0"><%= code.redeemedAt ? code.redeemedAt.toLocaleDateString() : '-' %></p></td>
                          <td>
                            <div class="d-flex flex-wrap gap-2">
                              <form action="<%= adminPath %>/access-codes/<%= code.id %>/extend" method="POST" class="d-flex gap-1">
                                <input type="hidden" name="days" value="30" />
                                <button type="submit" class="main-btn light-btn btn-hover btn-sm">+30d</button>
                              </form>
                              <% if (code.status !== 'revoked') { %>
                                <form action="<%= adminPath %>/access-codes/<%= code.id %>/revoke" method="POST">
                                  <button type="submit" class="main-btn danger-btn btn-hover btn-sm">Revoke</button>
                                </form>
                              <% } %>
                            </div>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <%- include('../partials/scripts.ejs') %>
  </body>
</html>
