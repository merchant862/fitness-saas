<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head.ejs') %>
    <title>FitAccess | Reset Password</title>
  </head>
  <body>

    <!-- ======== Preloader =========== -->
    <%- include('partials/spinner.ejs') %>
    <!-- ======== Preloader =========== -->

    <!-- ======== main-wrapper start =========== -->

      <!-- ========== signin-section start ========== -->
      <section class="signin-section">
        <div class="container-fluid">
          <div class="row g-0 auth-row">
            <div class="col-lg-6">
              <div class="auth-cover-wrapper bg-primary-100">
                <div class="auth-cover">
                  <div class="title text-center">
                    <img src="/images/logo/logo.svg" alt="logo" /><br>
                  </div>
                  <div class="cover-image">
                    <img src="assets/images/auth/signin-image.svg" alt="" />
                  </div>
                  <div class="shape-image">
                    <img src="assets/images/auth/shape.svg" alt="" />
                  </div>
                </div>
              </div>
            </div>
            <!-- end col -->

            <div class="col-lg-6">
              <div class="signin-wrapper">
                <div class="form-wrapper">
                  <h6 class="mb-15">Reset Password</h6>
                  <p class="text-sm mb-25">
                    Enter your email, reset code, and new password to regain access to your account.
                  </p>

                  <form action="#">
                    <div class="row">
                      <div class="col-12">
                        <div class="input-style-1">
                          <label>Email</label>
                          <input type="email" placeholder="Email" value="<%= resetPasswordData?.defaultValues?.email || '' %>" />
                        </div>
                      </div>
                      <!-- end col -->

                      <div class="col-12">
                        <div class="input-style-1">
                          <label>Reset Code</label>
                          <input type="text" placeholder="Reset Code" value="<%= resetPasswordData?.defaultValues?.resetCode || '' %>" />
                        </div>
                      </div>
                      <!-- end col -->

                      <div class="col-12">
                        <div class="input-style-1">
                          <label>New Password</label>
                          <input type="password" placeholder="New Password" />
                        </div>
                      </div>
                      <!-- end col -->

                      <div class="col-12">
                        <div class="input-style-1">
                          <label>Confirm Password</label>
                          <input type="password" placeholder="Confirm Password" />
                        </div>
                      </div>
                      <!-- end col -->

                      <div class="col-xxl-6 col-lg-12 col-md-6">
                        <div class="text-start mb-30">
                          <a href="/login" class="hover-underline">
                            Back to Login
                          </a>
                        </div>
                      </div>
                      <!-- end col -->

                      <div class="col-xxl-6 col-lg-12 col-md-6">
                        <div class="text-start text-md-end text-lg-start text-xxl-end mb-30">
                          <a href="/redeem-access" class="hover-underline">
                            Redeem Access Instead
                          </a>
                        </div>
                      </div>
                      <!-- end col -->

                      <div class="col-12">
                        <div class="button-group d-flex justify-content-center flex-wrap">
                          <button class="main-btn primary-btn btn-hover w-100 text-center">
                            Reset Password
                          </button>
                        </div>
                      </div>
                    </div>
                    <!-- end row -->
                  </form>
                </div>
              </div>
            </div>
            <!-- end col -->
          </div>
          <!-- end row -->
        </div>
      </section>
      <!-- ========== signin-section end ========== -->

    <!-- ======== main-wrapper end =========== -->

    <!-- ========= All Javascript files linkup ======== -->
    <%- include('partials/scripts.ejs') %>
  </body>
</html>