<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head.ejs') %>
    <title>FitAccess | Reset Password</title>
  </head>
  <body>

    <!-- ======== Preloader =========== -->
    <%- include('partials/spinner.ejs') %>
    <!-- ======== Preloader =========== -->

    <!-- ======== main-wrapper start =========== -->

      <!-- ========== signin-section start ========== -->
      <section class="signin-section">
        <div class="container-fluid">
          <div class="row g-0 auth-row">
            <div class="col-lg-6">
              <div class="auth-cover-wrapper bg-primary-100">
                <div class="auth-cover">
                  <div class="title text-center">
                    <img src="/images/logo/logo.svg" alt="logo" /><br>
                  </div>
                  <div class="cover-image">
                    <img src="assets/images/auth/signin-image.svg" alt="" />
                  </div>
                  <div class="shape-image">
                    <img src="assets/images/auth/shape.svg" alt="" />
                  </div>
                </div>
              </div>
            </div>
            <!-- end col -->

            <div class="col-lg-6">
              <div class="signin-wrapper">
                <div class="form-wrapper">
                  <h6 class="mb-15">Reset Password</h6>
                  <p class="text-sm mb-25">
                    Create a new password for your FitAccess account.
                  </p>
                  <% if (resetPasswordData?.message) { %>
                    <div class="alert-box success-alert mb-20">
                      <p class="text-sm mb-0"><%= resetPasswordData.message %></p>
                    </div>
                  <% } %>

                  <% if (resetPasswordData?.hasToken) { %>
                  <form action="/reset-password" method="POST">
                    <input type="hidden" name="email" value="<%= resetPasswordData.defaultValues.email %>" />
                    <input type="hidden" name="token" value="<%= resetPasswordData.defaultValues.token %>" />
                    <div class="row">
                      <div class="col-12">
                        <div class="input-style-1">
                          <label>New Password</label>
                          <div class="password-field">
                            <input type="password" name="newPassword" placeholder="New Password" required />
                            <button type="button" class="password-toggle-btn" data-password-toggle aria-label="Show password">
                              <i class="lni lni-eye"></i>
                            </button>
                          </div>
                        </div>
                      </div>
                      <!-- end col -->

                      <div class="col-12">
                        <div class="input-style-1">
                          <label>Confirm Password</label>
                          <div class="password-field">
                            <input type="password" name="confirmPassword" placeholder="Confirm Password" required />
                            <button type="button" class="password-toggle-btn" data-password-toggle aria-label="Show password">
                              <i class="lni lni-eye"></i>
                            </button>
                          </div>
                        </div>
                      </div>
                      <!-- end col -->

                      <div class="col-12">
                        <div class="text-start mb-30">
                          <a href="/sign-in" class="hover-underline">
                            Back to Sign-In
                          </a>
                        </div>
                      </div>
                      <!-- end col -->

                      <div class="col-12">
                        <div class="button-group d-flex justify-content-center flex-wrap">
                          <button class="main-btn primary-btn btn-hover w-100 text-center">
                            Reset Password
                          </button>
                        </div>
                      </div>
                    </div>
                    <!-- end row -->
                  </form>
                  <% } else { %>
                    <div class="alert-box warning-alert mb-25">
                      <p class="text-sm mb-0">Use the password reset link from your email. If it expired, request a new one.</p>
                    </div>
                    <a href="/forgot-password" class="main-btn primary-btn btn-hover w-100 text-center">
                      Request Reset Link
                    </a>
                  <% } %>
                </div>
              </div>
            </div>
            <!-- end col -->
          </div>
          <!-- end row -->
        </div>
      </section>
      <!-- ========== signin-section end ========== -->

    <!-- ======== main-wrapper end =========== -->

    <!-- ========= All Javascript files linkup ======== -->
    <%- include('partials/scripts.ejs') %>
  </body>
</html>
