<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head.ejs') %>
    <title>FitAccess | Access Email Sent</title>
  </head>
  <body>
    <% const data = redeemAccessData; %>

    <!-- ======== Preloader =========== -->
    <%- include('partials/spinner.ejs') %>
    <!-- ======== Preloader =========== -->

    <!-- ======== main-wrapper start =========== -->
    <main class="main-wrapper" style="margin-left: 0;">
      <!-- ========== section start ========== -->
      <section class="section">
        <div class="container-fluid">
          <div class="row justify-content-center pt-30">
            <div class="col-xl-10 col-lg-11">
              <div class="row">
                <div class="col-lg-6">
                  <div class="card-style mb-30">
                    <%- include('partials/brand-logo-dark.ejs', { href: '/' }) %><br><br>
                    <div class="title mb-25">
                      <h2>Access is sent by email</h2>
                      <p class="text-sm mt-10 mb-0">
                        Use the secure link in your inbox to continue. Manual code entry is no longer used.
                      </p>
                    </div>

                    <div class="alert-box success-alert mb-25">
                      <p class="text-sm mb-0">
                        Check the email you used at checkout. If you already have a password, you can sign in directly.
                      </p>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                      <a href="/sign-in" class="main-btn primary-btn btn-hover">
                        Sign In
                      </a>
                      <a href="/forgot-password" class="main-btn light-btn btn-hover">
                        Reset Password
                      </a>
                    </div>
                  </div>
                </div>

                <div class="col-lg-6">
                  <div class="access-visual-card mb-30">
                    <div class="access-visual-card__content">
                      <span>FitAccess member access</span>
                      <h3><%= data.statusCard.title %></h3>
                      <p><%= data.statusCard.description %></p>
                    </div>
                  </div>

                  <div class="card-style mb-30">
                    <div class="title mb-20">
                      <h6 class="text-medium">Need Help?</h6>
                    </div>

                    <p class="text-sm mb-10">
                      Make sure:
                    </p>

                    <ul style="padding-left: 18px; margin-bottom: 0;">
                      <li class="text-sm mb-12">You check the inbox used at checkout</li>
                      <li class="text-sm mb-12">You also check spam or promotions folders</li>
                      <li class="text-sm mb-12">You use the most recent sign-in email</li>
                    </ul>
                  </div>

                  <div class="card-style mb-30">
                    <div class="title mb-20">
                      <h6 class="text-medium">What Happens Next?</h6>
                    </div>

                    <p class="text-sm mb-10">
                      After successful activation:
                    </p>

                    <ol style="padding-left: 18px; margin-bottom: 0;">
                      <li class="text-sm mb-12">Your email link opens the account</li>
                      <li class="text-sm mb-12">You will complete onboarding if needed</li>
                      <li class="text-sm mb-12">Your personalized dashboard will unlock</li>
                    </ol>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
      <!-- ========== section end ========== -->
    </main>
    <!-- ======== main-wrapper end =========== -->

    <%- include('partials/scripts.ejs') %>
  </body>
</html>
