<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head.ejs') %>
    <title>FitAccess | Dashboard</title>
  </head>
  <body>
    <% const data = dashboardData; %>

    <!-- ======== Preloader =========== -->
    <%- include('partials/spinner.ejs') %>
    <!-- ======== Preloader =========== -->

    <!-- ======== sidebar-nav start =========== -->
    <%- include('partials/sidebar.ejs', { activePage: 'dashboard' }) %>
    <!-- ======== sidebar-nav end =========== -->

    <!-- ======== main-wrapper start =========== -->
    <main class="main-wrapper">
      <!-- ========== header start ========== -->
      <%- include('partials/header.ejs', {
        pageTitle: 'Fitness Dashboard',
        pageSubtitle: 'Track your workouts, meals, and progress.',
        currentUser: data.user
      }) %>
      <!-- ========== header end ========== -->

      <!-- ========== section start ========== -->
      <section class="section">
        <div class="container-fluid">
          <!-- ========== title-wrapper start ========== -->
          <div class="title-wrapper pt-30">
            <div class="row align-items-center">
              <div class="col-md-8">
                <div class="title">
                  <h2>Fitness Dashboard</h2>
                  <p class="text-sm text-medium">
                    Welcome back, <%= data.user.name %>. Your current goal is
                    <strong><%= data.user.goal %></strong>.
                  </p>
                </div>
              </div>
              <div class="col-md-4">
                <div class="breadcrumb-wrapper">
                  <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                      <li class="breadcrumb-item">
                        <a href="/dashboard">Home</a>
                      </li>
                      <li class="breadcrumb-item active" aria-current="page">
                        Dashboard
                      </li>
                    </ol>
                  </nav>
                </div>
              </div>
            </div>
          </div>
          <!-- ========== title-wrapper end ========== -->

          <!-- ========== quick actions start ========== -->
          <div class="row">
            <div class="col-lg-12">
              <div class="card-style mb-25">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                  <div>
                    <h6 class="text-medium mb-1">Quick Actions</h6>
                    <p class="text-sm mb-0">Jump straight into the next step.</p>
                  </div>

                  <div class="d-flex flex-wrap gap-2">
                    <a href="/workouts" class="main-btn primary-btn btn-hover btn-sm">
                      Start Workout
                    </a>

                    <a href="/meals" class="main-btn light-btn btn-hover btn-sm">
                      View Meals
                    </a>

                    <a href="/ai-coach" class="main-btn success-btn btn-hover btn-sm">
                      Ask AI Coach
                    </a>

                    <a href="/progress" class="main-btn orange-btn btn-hover btn-sm">
                      Check Progress
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <!-- ========== quick actions end ========== -->

          <!-- ========== stats cards start ========== -->
          <div class="row">
            <div class="col-xl-3 col-lg-4 col-sm-6">
              <div class="icon-card mb-30">
                <div class="icon purple">
                  <i class="lni lni-flame"></i>
                </div>
                <div class="content">
                  <h6 class="mb-10">Current Streak</h6>
                  <h3 class="text-bold mb-10"><%= data.stats.streakDays %> Days</h3>
                  <p class="text-sm text-success">Keep the momentum going</p>
                </div>
              </div>
            </div>

            <div class="col-xl-3 col-lg-4 col-sm-6">
              <div class="icon-card mb-30">
                <div class="icon success">
                  <i class="lni lni-checkmark-circle"></i>
                </div>
                <div class="content">
                  <h6 class="mb-10">Workouts Done</h6>
                  <h3 class="text-bold mb-10"><%= data.stats.workoutsCompleted %></h3>
                  <p class="text-sm text-success">Completed this month</p>
                </div>
              </div>
            </div>

            <div class="col-xl-3 col-lg-4 col-sm-6">
              <div class="icon-card mb-30">
                <div class="icon primary">
                  <i class="lni lni-dinner"></i>
                </div>
                <div class="content">
                  <h6 class="mb-10">Meals Followed</h6>
                  <h3 class="text-bold mb-10"><%= data.stats.mealsFollowed %></h3>
                  <p class="text-sm text-success">Nutrition consistency</p>
                </div>
              </div>
            </div>

            <div class="col-xl-3 col-lg-4 col-sm-6">
              <div class="icon-card mb-30">
                <div class="icon orange">
                  <i class="lni lni-bar-chart"></i>
                </div>
                <div class="content">
                  <h6 class="mb-10">Current Weight</h6>
                  <h3 class="text-bold mb-10"><%= data.stats.currentWeight %> kg</h3>
                  <p class="text-sm text-gray">
                    Target: <%= data.stats.targetWeight %> kg
                  </p>
                </div>
              </div>
            </div>
          </div>
          <!-- ========== stats cards end ========== -->

          <!-- ========== workout + ai start ========== -->
          <div class="row">
            <div class="col-lg-7">
              <div class="card-style mb-30">
                <div class="title d-flex flex-wrap justify-content-between align-items-center">
                  <div class="left">
                    <h6 class="text-medium mb-10">Today's Workout</h6>
                    <h3 class="text-bold"><%= data.todayWorkout.title %></h3>
                  </div>
                  <div class="right">
                    <a href="/workouts" class="main-btn primary-btn btn-hover btn-sm">
                      View Plan
                    </a>
                  </div>
                </div>

                <div class="row mt-20">
                  <div class="col-md-3 col-6 mb-15">
                    <p class="text-sm mb-1"><strong>Day</strong></p>
                    <p class="text-sm"><%= data.todayWorkout.dayLabel %></p>
                  </div>
                  <div class="col-md-3 col-6 mb-15">
                    <p class="text-sm mb-1"><strong>Duration</strong></p>
                    <p class="text-sm"><%= data.todayWorkout.duration %></p>
                  </div>
                  <div class="col-md-3 col-6 mb-15">
                    <p class="text-sm mb-1"><strong>Focus</strong></p>
                    <p class="text-sm"><%= data.todayWorkout.focus %></p>
                  </div>
                  <div class="col-md-3 col-6 mb-15">
                    <p class="text-sm mb-1"><strong>Level</strong></p>
                    <p class="text-sm"><%= data.user.level %></p>
                  </div>
                </div>

                <div class="mt-15">
                  <a href="/workouts" class="main-btn primary-btn btn-hover">
                    Start Workout
                  </a>
                </div>
              </div>
            </div>

            <div class="col-lg-5">
              <div class="card-style mb-30">
                <div class="title">
                  <h6 class="text-medium mb-20">AI Tip of the Day</h6>
                </div>

                <p class="text-sm" style="line-height: 1.8;">
                  <%= data.aiTip %>
                </p>

                <div class="mt-20">
                  <a href="/ai-coach" class="main-btn light-btn btn-hover btn-sm">
                    Ask AI Coach
                  </a>
                </div>
              </div>
            </div>
          </div>
          <!-- ========== workout + ai end ========== -->

          <!-- ========== meals + progress start ========== -->
          <div class="row">
            <div class="col-lg-7">
              <div class="card-style mb-30">
                <div class="title d-flex flex-wrap justify-content-between align-items-center">
                  <div class="left">
                    <h6 class="text-medium mb-20">Today's Meals</h6>
                  </div>
                  <div class="right">
                    <a href="/meals" class="main-btn primary-btn btn-hover btn-sm">
                      View Meal Plan
                    </a>
                  </div>
                </div>

                <div class="table-responsive">
                  <table class="table">
                    <tbody>
                      <tr>
                        <td><strong>Breakfast</strong></td>
                        <td><%= data.todayMeals.breakfast %></td>
                      </tr>
                      <tr>
                        <td><strong>Lunch</strong></td>
                        <td><%= data.todayMeals.lunch %></td>
                      </tr>
                      <tr>
                        <td><strong>Dinner</strong></td>
                        <td><%= data.todayMeals.dinner %></td>
                      </tr>
                      <tr>
                        <td><strong>Snack</strong></td>
                        <td><%= data.todayMeals.snack %></td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>

            <div class="col-lg-5">
              <div class="card-style mb-30">
                <div class="title">
                  <h6 class="text-medium mb-20">Progress Summary</h6>
                </div>

                <div class="mb-20">
                  <p class="text-sm mb-10">
                    <strong>Current Weight:</strong>
                    <%= data.stats.currentWeight %> kg
                  </p>
                  <p class="text-sm mb-10">
                    <strong>Target Weight:</strong>
                    <%= data.stats.targetWeight %> kg
                  </p>
                  <p class="text-sm mb-10">
                    <strong>This Week:</strong>
                    <%= data.progress.weeklyChange %>
                  </p>
                  <p class="text-sm mb-10">
                    <strong>Program Completion:</strong>
                    <%= data.progress.completionRate %>
                  </p>
                  <p class="text-sm mb-10">
                    <strong>Environment:</strong>
                    <%= data.user.environment %>
                  </p>
                </div>

                <a href="/progress" class="main-btn light-btn btn-hover btn-sm">
                  View Progress
                </a>
              </div>
            </div>
          </div>
          <!-- ========== meals + progress end ========== -->
        </div>
      </section>
      <!-- ========== section end ========== -->
    </main>
    <!-- ======== main-wrapper end =========== -->

    <%- include('partials/scripts.ejs') %>
  </body>
</html>