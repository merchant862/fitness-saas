<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/images/favicon.svg?v=fitaccess-2" type="image/svg+xml" />
    <link rel="shortcut icon" href="/images/favicon.svg?v=fitaccess-2" type="image/svg+xml" />
    <link rel="stylesheet" href="/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/lineicons.css" />
    <title><%= pageTitle %></title>
    <style>
      :root {
        --ink: #101828;
        --muted: #667085;
        --line: #e4e7ec;
        --panel: #f8fafc;
        --blue: #365cf5;
        --dark: #08111f;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        color: var(--ink);
        background: #ffffff;
        font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      a {
        color: var(--blue);
        text-decoration: none;
      }

      a:hover {
        color: #2448df;
      }

      .legal-nav {
        border-bottom: 1px solid var(--line);
        background: rgba(255, 255, 255, 0.96);
      }

      .containerx {
        width: min(1040px, calc(100% - 40px));
        margin: 0 auto;
      }

      .legal-nav-inner {
        min-height: 74px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
      }

      .legal-logo img {
        display: block;
        width: 150px;
        height: auto;
      }

      .legal-nav-links {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
      }

      .legal-nav-links a {
        min-height: 38px;
        display: inline-flex;
        align-items: center;
        padding: 0 12px;
        border: 1px solid transparent;
        border-radius: 8px;
        color: #344054;
        font-size: 13px;
        font-weight: 700;
      }

      .legal-nav-links a:hover {
        color: var(--blue);
        border-color: #dce3ff;
        background: #f2f5ff;
      }

      .legal-hero {
        padding: 72px 0 34px;
        background: var(--panel);
        border-bottom: 1px solid var(--line);
      }

      .legal-hero h1 {
        margin: 0 0 14px;
        color: var(--ink);
        font-size: clamp(34px, 6vw, 58px);
        line-height: 1.05;
        font-weight: 900;
        letter-spacing: 0;
      }

      .legal-meta {
        display: grid;
        gap: 7px;
        color: var(--muted);
        font-size: 15px;
        line-height: 1.6;
      }

      .legal-content {
        padding: 48px 0 72px;
      }

      .legal-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 260px;
        gap: 44px;
        align-items: start;
      }

      .legal-card {
        min-width: 0;
        padding: 34px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: #ffffff;
      }

      .legal-section {
        padding: 0 0 26px;
        margin: 0 0 28px;
        border-bottom: 1px solid var(--line);
      }

      .legal-section:last-child {
        padding-bottom: 0;
        margin-bottom: 0;
        border-bottom: 0;
      }

      .legal-section h2 {
        margin: 0 0 12px;
        color: var(--ink);
        font-size: 22px;
        line-height: 1.25;
        font-weight: 900;
      }

      .legal-section p,
      .legal-section li {
        color: #475467;
        font-size: 15px;
        line-height: 1.75;
      }

      .legal-section p {
        margin: 0 0 14px;
      }

      .legal-section p:last-child {
        margin-bottom: 0;
      }

      .legal-section ul {
        margin: 10px 0 0;
        padding-left: 22px;
      }

      .legal-side {
        position: sticky;
        top: 22px;
        padding: 20px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: #ffffff;
      }

      .legal-side h2 {
        margin: 0 0 12px;
        color: var(--ink);
        font-size: 13px;
        font-weight: 900;
        text-transform: uppercase;
      }

      .legal-side a {
        min-height: 36px;
        display: flex;
        align-items: center;
        border-bottom: 1px solid #eef2f7;
        color: #667085;
        font-size: 14px;
        font-weight: 500;
      }

      .legal-side a:last-child {
        border-bottom: 0;
      }

      .legal-side a:hover,
      .legal-side a.active {
        color: var(--blue);
      }

      .legal-footer {
        padding: 22px 0;
        color: #cbd5e1;
        background: var(--dark);
        font-size: 13px;
      }

      .legal-footer-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }

      .legal-footer a {
        color: #ffffff;
        font-weight: 700;
      }

      @media (max-width: 820px) {
        .legal-nav-inner,
        .legal-footer-inner {
          align-items: flex-start;
          flex-direction: column;
        }

        .legal-layout {
          grid-template-columns: 1fr;
          gap: 22px;
        }

        .legal-side {
          position: static;
          order: -1;
        }

        .legal-card {
          padding: 24px 20px;
        }

        .legal-hero {
          padding: 48px 0 28px;
        }
      }
    </style>
  </head>
  <body>
    <% const data = legalData; %>
    <nav class="legal-nav">
      <div class="containerx legal-nav-inner">
        <a href="/" class="legal-logo" aria-label="FitAccess Home">
          <img src="/images/logo/logo.svg" alt="FitAccess" />
        </a>
        <div class="legal-nav-links">
          <a href="/">Home</a>
          <% if (data.currentUser) { %>
            <a href="/dashboard">Dashboard</a>
          <% } else { %>
            <a href="/sign-in">Sign In</a>
          <% } %>
        </div>
      </div>
    </nav>

    <header class="legal-hero">
      <div class="containerx">
        <h1><%= data.page.title %></h1>
        <div class="legal-meta">
          <span>FitAccess is operated by <%= data.companyNames %>.</span>
          <span>Throughout these policies, &ldquo;FitAccess,&rdquo; &ldquo;we,&rdquo; &ldquo;us,&rdquo; and &ldquo;our&rdquo; refer to FitAccess and <%= data.companyNames %>. &ldquo;You,&rdquo; &ldquo;member,&rdquo; and &ldquo;user&rdquo; refer to any person who visits, purchases, accesses, or uses FitAccess.</span>
          <span>Contact: <a href="mailto:<%= data.supportEmail %>"><%= data.supportEmail %></a></span>
          <span>Website: <a href="<%= data.websiteUrl %>"><%= data.websiteUrl %></a></span>
        </div>
      </div>
    </header>

    <main class="legal-content">
      <div class="containerx legal-layout">
        <article class="legal-card">
          <% data.page.sections.forEach((section, index) => { %>
            <section class="legal-section">
              <% if (section.title) { %>
                <h2><%= index + 1 %>. <%= section.title %></h2>
              <% } %>
              <% section.paragraphs.forEach((paragraph) => { %>
                <p><%= paragraph %></p>
              <% }) %>
              <% if (section.bullets.length) { %>
                <ul>
                  <% section.bullets.forEach((bullet) => { %>
                    <li><%= bullet %></li>
                  <% }) %>
                </ul>
              <% } %>
            </section>
          <% }) %>
        </article>

        <aside class="legal-side" aria-label="Legal pages">
          <h2>Legal Pages</h2>
          <a href="/terms-and-conditions" class="<%= data.page.title === 'Terms and Conditions' ? 'active' : '' %>">Terms and Conditions</a>
          <a href="/privacy-policy" class="<%= data.page.title === 'Privacy Policy' ? 'active' : '' %>">Privacy Policy</a>
          <a href="/refund-policy" class="<%= data.page.title === 'Refund Policy' ? 'active' : '' %>">Refund Policy</a>
          <a href="/do-not-sell-or-share" class="<%= data.page.title === 'Do Not Sell or Share My Personal Information' ? 'active' : '' %>">Do Not Sell or Share</a>
          <a href="/billing-disclosure" class="<%= data.page.title === 'Billing Disclosure for Checkout / Upsell Page' ? 'active' : '' %>">Billing Disclosure</a>
        </aside>
      </div>
    </main>

    <footer class="legal-footer">
      <div class="containerx legal-footer-inner">
        <span>&copy; <%= new Date().getFullYear() %> FitAccess</span>
        <a href="mailto:<%= data.supportEmail %>"><%= data.supportEmail %></a>
      </div>
    </footer>
  </body>
</html>
